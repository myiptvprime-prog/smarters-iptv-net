---
import { multiScreenPlans, singleScreenPlans, site } from "../data/site";
---

<section class="section" id="angebote">
  <div class="section-title">
    <p class="eyebrow">IPTV Abo Deutschland</p>
    <h2><span class="text-red">IPTV</span> Pakete klar vergleichen und per WhatsApp anfragen</h2>
    <p>Waehlen Sie Laufzeit, Senderumfang und Anzahl der Geraete. Alle Pakete sind in EUR angegeben, enthalten Einrichtungshilfe und werden ohne versteckte automatische Verlaengerung dargestellt.</p>
  </div>
  <div class="plan-switch">
    <input class="plan-radio" id="plans-single" type="radio" name="plan-mode" checked />
    <input class="plan-radio" id="plans-multi" type="radio" name="plan-mode" />
    <div class="plan-tabs" aria-label="Abonnement Anzahl Geraete">
      <label for="plans-single">1 Gerät</label>
      <label for="plans-multi">2 Geräte <strong>MAX</strong></label>
    </div>
    <div class="plan-panels">
      <div class="pricing-grid plan-panel single-panel">
        {singleScreenPlans.map((plan) => (
          <article class:list={["price-card", { selected: plan.popular }]} id={plan.id}>
            <div class="card-top">
              <span>{plan.badge}</span>
              <strong>{plan.discount}</strong>
            </div>
            <h3>{plan.name}</h3>
            <p class="plan-meta">{plan.channels} - {plan.duration}</p>
            <p class="price">{plan.price}</p>
            <small>ca. {(plan.priceValue / plan.includedMonths).toFixed(2)} EUR / Monat</small>
            <ul>
              {plan.features.map((feature) => <li>{feature}</li>)}
            </ul>
            <a class="button primary" href={site.whatsappUrl} aria-label={`${plan.name} fuer Deutschland per WhatsApp auswaehlen`}>Abo auswaehlen</a>
          </article>
        ))}
      </div>
      <div class="pricing-grid plan-panel multi-panel">
        {multiScreenPlans.map((plan) => (
          <article class:list={["price-card multi-card", { selected: plan.popular }]} id={plan.id}>
            <div class="card-top">
              <span>{plan.popular ? "Beliebt" : "2 Geräte"}</span>
              <strong>{plan.discount}</strong>
            </div>
            <h3>{plan.name}</h3>
            <p class="plan-meta">2 Geräte gleichzeitig - {plan.channels}</p>
            <p class="price">{plan.price}</p>
            <small>ca. {(plan.priceValue / plan.includedMonths).toFixed(2)} EUR / Monat</small>
            <ul>
              <li>2 Geräte gleichzeitig</li>
              {plan.highlights?.map((highlight) => <li>{highlight}</li>)}
              <li>HD, FHD und 4K nach Verfuegbarkeit</li>
              <li>Einrichtungshilfe per WhatsApp</li>
            </ul>
            <a class="button primary" href={site.whatsappUrl} aria-label={`${plan.name} fuer Deutschland per WhatsApp auswaehlen`}>Abo auswaehlen</a>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
