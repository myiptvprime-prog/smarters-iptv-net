<header class="site-header">
  <a class="brand" href="/" aria-label="Smarters IPTV Startseite">
    <img src="/logo-new.svg" width="268" height="64" alt="Smarters IPTV" />
  </a>
  <nav class="nav" aria-label="Hauptnavigation">
    {navLinks.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
</header>
