---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Pricing from "./Pricing.astro";
import ContentBlocks from "./ContentBlocks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  bullets: string[];
  showPricing?: boolean;
  canonical?: string;
}

const { title, description, eyebrow, heading, intro, bullets, showPricing = false, canonical } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />
  <main>
    <section class="page-hero">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        <p>{intro}</p>
        <div class="hero-actions">
          <a class="button primary" href={site.whatsappUrl} aria-label={`${heading} per WhatsApp anfragen`}>Beratung starten</a>
          <a class="button secondary" href="/iptv-abo-deutschland/">Pakete ansehen</a>
        </div>
      </div>
    </section>
    <section class="section editorial">
      <div>
        <h2>Das Wichtigste vor der Auswahl</h2>
        <p>Diese Seite hilft bei einer konkreten Entscheidung: welches Paket passt, welches Geraet funktioniert und welche Informationen Sie vor der Aktivierung pruefen sollten.</p>
      </div>
      <div class="bullet-grid">
        {bullets.map((bullet) => <article><p>{bullet}</p></article>)}
      </div>
    </section>
    {showPricing ? <Pricing /> : <ContentBlocks />}
  </main>
  <Footer />
</BaseLayout>
